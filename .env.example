# ==============================================================================
# CyberOps Root Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Frontend Configuration
# Local dev: http://localhost:8000
# Production / EC2: http://<YOUR_EC2_PUBLIC_IP>:8000 or relative /api
VITE_API_URL=http://localhost:8000

# Backend Configuration
DATABASE_URL=sqlite:///./cyberops.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
